{
  "name": "opencode-to-api",
  "version": "1.6.0",
  "description": "Standalone OpenAI-compatible API server powered by OpenCode Zen and KiloCode Gateway",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "opencode-to-api": "./src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test tests/**/*.test.js",
    "verify": "node src/verify.js",
    "verify:quick": "node src/verify.js --quick"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "opencode",
    "kilocode",
    "openai",
    "api",
    "llm",
    "termux",
    "standalone"
  ],
  "author": "opencode-to-api contributors",
  "license": "MIT"
}
