# Server Configuration
PORT=18080
HOST=127.0.0.1

# Optional: custom local API key for clients (leave blank to auto-generate and persist)
LOCAL_API_KEY=

# Debugging (0 = silent, 1 = verbose diagnostics)
DEBUG=0

# Timeout in milliseconds (default 5 minutes)
TIMEOUT_MS=300000

# Optional OpenCode User-Agent override
BANSOS_OPENCODE_UA=
